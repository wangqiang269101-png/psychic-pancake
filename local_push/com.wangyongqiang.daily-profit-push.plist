<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wangyongqiang.daily-profit-push</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/wangyongqiang/Library/Application Support/profit-push/run_profit_push.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/wangyongqiang/Library/Application Support/profit-push</string>

  <key>RunAtLoad</key>
  <true/>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>StandardOutPath</key>
  <string>/Users/wangyongqiang/Library/Application Support/profit-push/logs/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/wangyongqiang/Library/Application Support/profit-push/logs/launchd.err.log</string>
</dict>
</plist>
