# Required
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace-me

# Recommended: stable JSON endpoint that returns Power BI rows
PROFIT_SOURCE_MODE=http_json
PROFIT_DATA_JSON_URL=https://example.com/profit/latest.json
# Optional JSON object string for auth headers
# PROFIT_DATA_JSON_HEADERS={"Authorization":"Bearer xxx","x-api-key":"xxx"}

# Optional: report embed url for scrape mode fallback
POWERBI_REPORT_URL=https://app.powerbi.com/reportEmbed?reportId=aa5bfe1a-b218-4be5-83e3-ce61bfd8d6c2&autoAuth=true&ctid=7c792a97-2300-4444-aa97-172fed9b0501

# Data freshness guards
TARGET_DATA_LAG_DAYS=2
MAX_DATA_LAG_DAYS=2

# Retry tuning
WECOM_MAX_ATTEMPTS=4
WECOM_TIMEOUT_SECONDS=30
WECOM_RETRY_BASE_SECONDS=1.5
